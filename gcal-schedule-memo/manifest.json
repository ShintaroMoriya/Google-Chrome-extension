{
  "manifest_version": 3,
  "name": "日程アシスト",
  "version": "1.1.0",
  "description": "Googleカレンダーの候補日時を3件まで集め、定型メールに差し込んでコピーできる日程調整アシストです。",
  "permissions": ["storage"],
  "host_permissions": ["https://calendar.google.com/*"],
  "action": {
    "default_title": "日程アシスト 表示/非表示（クリックで開閉）",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": [
        "src/format.js",
        "src/datekey.js",
        "src/timeparse.js",
        "src/geometry.js",
        "src/extract.js",
        "src/store.js",
        "src/templates.js",
        "src/panel.js",
        "src/preview.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
